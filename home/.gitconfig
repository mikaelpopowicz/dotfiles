[core]
	excludesfile = ~/.global-gitignore
	autocrlf = input
	pager = delta

[user]
	name = Mikaël Popowicz
	email = mikael.popowicz@big-boss-studio.com
	signingkey = ~/.ssh/id_ed25519.pub

[commit]
	gpgsign = true

[gpg]
	format = ssh

# Gmail identity only under ~/code/ (see home/.gitconfig-private)
[includeIf "gitdir:~/code/"]
	path = ~/.gitconfig-private
[includeIf "gitdir:~/Code/"]
	path = ~/.gitconfig-private

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[fetch]
	prune = true

[pull]
	rebase = false

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	st = status
	co = commit
	ch = checkout
	br = branch
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an <%ae>%Creset' --abbrev-commit
	po = push origin
	fo = fetch origin
	tree = ls-tree -r HEAD --name-only

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
